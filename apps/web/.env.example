# Blank = same-origin /api/calendar (integrated local relay or future reverse proxy).
# No tokens or credentials may appear in VITE_* variables.
VITE_CALENDAR_RELAY_URL=
# Split local example: http://127.0.0.1:8787
# Future overseas relay: https://calendar-relay.example.invalid
# Integrated dev/preview relay settings must be passed in the shell at startup,
# not in this Vite dotenv file or VITE_* variables. See docs/CALENDAR_RELAY.md:
# RELAY_LOCAL_FAKE_IP_CIDRS=198.18.0.0/15
# RELAY_ORIGINS=http://192.168.0.10:4173,http://127.0.0.1:4173,http://localhost:4173

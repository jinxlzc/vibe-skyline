{
  "name": "@vibeskyline/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src server vite.config.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=server/dist/index.mjs",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@react-three/drei": "^10.0.7",
    "@react-three/fiber": "^9.1.2",
    "@tailwindcss/vite": "^4.3.5",
    "@vibeskyline/adapters-core": "workspace:*",
    "@vibeskyline/calendars": "workspace:*",
    "@vibeskyline/contracts": "workspace:*",
    "@vibeskyline/core": "workspace:*",
    "@vibeskyline/geometry": "workspace:*",
    "@vibeskyline/logos": "workspace:*",
    "@vibeskyline/registry": "workspace:*",
    "@vibeskyline/stl": "workspace:*",
    "@vibeskyline/three-mf": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fzstd": "^0.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "three": "^0.176.0",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "^0.176.0",
    "@vitejs/plugin-react": "^4.4.1",
    "vite": "^6.3.5"
  }
}

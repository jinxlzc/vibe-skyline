# Pass these through your shell/process manager; no dotenv auto-loader.
RELAY_HOST=127.0.0.1
RELAY_PORT=8787
RELAY_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173
# Default off. Local trusted TUN only: canonical subnets within 198.18.0.0/15.
# Example shell opt-in: RELAY_LOCAL_FAKE_IP_CIDRS=198.18.0.0/15
RELAY_LOCAL_FAKE_IP_CIDRS=
# Existing public-page fetchers use no token. Never put tokens in frontend config.

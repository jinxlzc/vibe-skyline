{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VibeSkyline Activity Bundle v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "vibeskyline.activity.v2"
    },
    "year": {
      "type": "integer",
      "minimum": 1970,
      "maximum": 2100
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "client": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]*$"
          },
          "accountingProfile": {
            "enum": [
              "inclusive-tokens-v1",
              "daily-count-v1",
              "contributions-v1",
              "activity-level-v1"
            ]
          },
          "scopeId": {
            "const": "daily"
          },
          "publicIdentity": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "provider": {
                "enum": [
                  "github",
                  "gitee",
                  "gitlab",
                  "source"
                ]
              },
              "kind": {
                "enum": [
                  "username",
                  "public-id"
                ]
              },
              "value": {
                "type": "string",
                "maxLength": 39,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
              },
              "provenance": {
                "enum": [
                  "explicit-public-handle",
                  "explicit-public-id"
                ]
              }
            },
            "required": [
              "provider",
              "kind",
              "value",
              "provenance"
            ]
          },
          "metric": {
            "enum": [
              "tokens",
              "contributions",
              "activity_level",
              "events",
              "credits",
              "premium_requests"
            ]
          },
          "unit": {
            "enum": [
              "token",
              "contribution",
              "level",
              "event",
              "credit",
              "request"
            ]
          },
          "unitScale": {
            "const": 1
          },
          "calendar": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "timezone": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[A-Za-z_+-]+(?:/[A-Za-z0-9_+.-]+)*$"
              },
              "dateBasis": {
                "enum": [
                  "timestamp-derived",
                  "source-reported"
                ]
              }
            },
            "required": [
              "timezone",
              "dateBasis"
            ]
          },
          "coverage": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "from": {
                  "type": "string",
                  "format": "date"
                },
                "to": {
                  "type": "string",
                  "format": "date"
                },
                "kind": {
                  "enum": [
                    "full",
                    "partial"
                  ]
                }
              },
              "required": [
                "from",
                "to",
                "kind"
              ]
            },
            "maxItems": 366
          },
          "days": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "state": {
                  "enum": [
                    "observed",
                    "known-zero",
                    "unknown",
                    "future"
                  ]
                },
                "completeness": {
                  "enum": [
                    "complete",
                    "partial",
                    "unknown"
                  ]
                },
                "quality": {
                  "enum": [
                    "reported",
                    "derived",
                    "manual"
                  ]
                },
                "tokens": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "in": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "out": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "cacheRead": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "cacheWrite": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "reasoning": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "in",
                    "out"
                  ]
                }
              },
              "required": [
                "date",
                "value",
                "state",
                "completeness",
                "quality"
              ]
            },
            "maxItems": 366
          },
          "provenanceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "maxItems": 6
          },
          "sample": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "client",
          "accountingProfile",
          "scopeId",
          "metric",
          "unit",
          "unitScale",
          "calendar",
          "coverage",
          "days",
          "provenanceIds",
          "sample"
        ]
      },
      "maxItems": 6,
      "minItems": 1
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "adapter": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]*$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]*$"
          },
          "method": {
            "enum": [
              "synthetic",
              "local",
              "public-http",
              "manual"
            ]
          },
          "status": {
            "enum": [
              "fixture-tested",
              "manual",
              "in-progress"
            ]
          }
        },
        "required": [
          "id",
          "adapter",
          "version",
          "method",
          "status"
        ]
      },
      "maxItems": 6,
      "minItems": 1
    },
    "reconciliation": {
      "type": "array",
      "maxItems": 0
    }
  },
  "required": [
    "schema",
    "year",
    "generatedAt",
    "sources",
    "provenance",
    "reconciliation"
  ]
}

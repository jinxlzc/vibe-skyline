{
  "name": "vibeskyline-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "pnpm --filter @vibeskyline/web dev",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "tsx scripts/live.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "pnpm -r build",
    "start": "node apps/web/server/dist/index.mjs",
    "relay": "tsx apps/relay/src/server.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.15.0",
    "@types/opentype.js": "^1.3.8",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.0",
    "fast-check": "^4.1.1",
    "fast-xml-parser": "^5.2.1",
    "fflate": "0.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vitest": "^3.2.4"
  }
}
